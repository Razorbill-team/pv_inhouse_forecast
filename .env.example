# Copy to .env (same folder) and fill in. Never commit .env. Write @ in a password as %40.
# Production database, read only: plant data and the weather table
POSTDB_URL=postgresql+psycopg2://USER:PASSWORD@10.50.0.1:5432/postdb
WEATHER_TABLE=integration_schema.open_meteo_forecast_hourly
# Database the weather collector writes WEATHER_TABLE to (on production the same server as POSTDB_URL)
WEATHER_DB_URL=postgresql+psycopg2://USER:PASSWORD@10.50.0.1:5432/postdb
# Database and table the forecast is written to. On production only this table is accepted.
FORECAST_DB_URL=postgresql+psycopg2://USER:PASSWORD@10.50.0.1:5432/postdb
FORECAST_TABLE=integration_schema.forecast_internal
# Open-Meteo paid plan key (API Professional). Leave empty for the free tier.
OPEN_METEO_API_KEY=
